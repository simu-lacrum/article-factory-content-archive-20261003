.seo-cache/

# Local secrets and credentials must never enter the public repository.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*

# Regenerable local runtime artifacts.
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.DS_Store
Thumbs.db
.ruff_cache/
.idea/
.vscode/
desktop.ini

# Scratch, debug and temporary files.
*.log
*.tmp
*.bak
*.orig
*.swp
*~
~$*
_video_analysis/
_scratch/
tmp/

# One-off local snapshots of the SQLite index and its journals.
.article-factory/backups/
*.db-journal
*.db-wal
*.db-shm

# Archives of output folders are regenerable from the folders themselves.
output/**/*.zip
output/**/*.rar
output/**/*.7z

# Private publishing credentials (e.g. Rentry edit codes) must stay local.
**/edit-codes.json

# Intermediate `prepare` outputs (regenerated by `python -m article_factory prepare`).
# Files still referenced by articles/scripts stay tracked; new ones are ignored.
output/prompts/
output/evidence/
output/briefs/
output/codex_tasks/
output/runs/
/CURRENT_CODEX_TASK.md
