{
  "schema_version": 1,
  "fact_set": "article-visual-prompt-guide-v1",
  "description": "Mandatory B-first two-branch visual prompt system derived from twenty user references, with strict reference fidelity, branch-dependent mapped brand color roles, failure memory, and Nano Banana Pro optimization.",
  "entities": [
    {
      "id": "instruction:article-visual-prompt-guide",
      "kind": "mandatory_instruction",
      "label": "Article visual prompt guide v1",
      "props": {
        "mandatory_on_session_start": true,
        "priority": "critical",
        "version": "1.3.0",
        "style_system": "article-editorial-poster-v1",
        "primary_model": "gemini-3-pro-image",
        "canonical_file": "knowledge/agent_memory/rules/article-visual-prompt-guide.md",
        "required_files": [
          "AGENTS.md",
          "SEO_ARTICLE_RULES.md",
          "knowledge/agent_memory/rules/article-visual-prompt-guide.md",
          "memory/graph/knowledge-graph.json"
        ],
        "required_markers": {
          "knowledge/agent_memory/rules/article-visual-prompt-guide.md": [
            "MANDATORY_SESSION_GUIDE: article-editorial-poster-v1",
            "### 4.11. Обязательное чередование A/B",
            "### 4.12. Разобранный промах: industrial deck вместо ветки B",
            "## 6. Специфика Nano Banana Pro",
            "## 18. Минимальный контракт промпта",
            "## 19. 100-балльная проверка качества",
            "Cluster / `cluster.center` для CS2 и Deadlock: `#635FD5`;",
            "Melonity для Dota 2: `#FF1469`."
          ]
        },
        "scope": "Every new Codex session; all article ideation, briefs, drafts, image prompts, covers, inline illustrations, diagrams, and social crops.",
        "session_directive": "Run graph bootstrap, require 100% node and edge coverage, read every required file fully, compile every final visual prompt through article-editorial-poster-v1, alternate generated assets B/A starting with warm narrative B, attach two persistent references and pass 4/5 fidelity for B, and use mapped colors Cluster #635FD5 or Melonity #FF1469 as a small accent in A or the dominant yellow-field replacement in B."
      }
    },
    {
      "id": "model:gemini-3-pro-image",
      "kind": "image_model",
      "label": "Nano Banana Pro / Gemini 3 Pro Image",
      "props": {
        "model_code": "gemini-3-pro-image",
        "role": "primary image generator",
        "supported_sizes": ["1K", "2K", "4K"],
        "supported_aspect_ratios": ["1:1", "2:3", "3:2", "3:4", "4:3", "4:5", "5:4", "9:16", "16:9", "21:9"],
        "prompt_mode": "natural-language creative brief with explicit priorities",
        "reference_policy": "Assign one explicit role to every uploaded image; use only the smallest relevant subset of references.",
        "typography_policy": "Use art-first by default; text-in-image is allowed for exact short copy followed by character-level QA.",
        "official_docs": "https://ai.google.dev/gemini-api/docs/image-generation"
      }
    },
    {
      "id": "style:article-editorial-poster-v1",
      "kind": "visual_style_system",
      "label": "Editorial tech product poster",
      "props": {
        "summary": "Two alternating branches: A uses one tactile industrial hero object and product-photography lighting; B uses a warm narrative 3D/2.5D scene or symbolic object. Both keep bold grotesk typography or an empty safe zone, two to three color roles, controlled surrealism, and strong hierarchy.",
        "anti_style": "Generic gaming key art, cyberpunk neon, HUD clutter, logo copying, character copying, or aesthetic tags without physical direction."
      }
    },
    {
      "id": "style:article-editorial-poster-v1-a",
      "kind": "visual_style_branch",
      "label": "Branch A — tactile industrial product poster",
      "props": {
        "sequence_parity": "even generated_sequence_index",
        "best_for": ["systems", "technical mechanisms", "feature comparison", "anti-cheat analysis", "process visualization"],
        "signals": ["one physical device", "tactile plastic/glass/metal", "studio or industrial set", "product-photography light", "controlled physical surrealism"]
      }
    },
    {
      "id": "style:article-editorial-poster-v1-b",
      "kind": "visual_style_branch",
      "label": "Branch B — warm narrative editorial ad",
      "props": {
        "sequence_parity": "odd generated_sequence_index",
        "submodes": ["B1 story scene", "B2 modular message card", "B3 symbolic object"],
        "best_for": ["player pain point", "mistakes", "human consequence", "simple benefit", "FAQ", "onboarding", "light humor"],
        "signals": ["sunlit saturated field", "mapped brand color replaces yellow or amber when a product is present", "rounded 3D or 2.5D forms", "one domestic story", "large typography zone", "one dry absurdist turn", "one semantic gesture"]
      }
    },
    {
      "id": "concept:generated-visual-alternation",
      "kind": "mandatory_visual_rule",
      "label": "Global A/B generated-asset alternation",
      "props": {
        "rule": "Number conceptual generated images across the current run; odd indices use warm narrative B and even indices use tactile industrial A.",
        "screenshots": "Real screenshots, verified product UI, and gameplay screenshots do not consume an index.",
        "no_blend": "One branch must dominate each asset; adjacent generated images may not repeat a branch.",
        "required_fields": ["generated_sequence_index", "style_branch"],
        "start_branch": "B so a one-cover run includes the new reference family"
      }
    },
    {
      "id": "concept:warm-story-reference-fidelity",
      "kind": "mandatory_visual_rule",
      "label": "Branch B requires two references and 4/5 fidelity",
      "props": {
        "required_reference_count": 2,
        "composition_reference": "One uploaded file from knowledge/agent_memory/references/article-editorial-warm-story-v1/",
        "render_reference": "A second uploaded file for render, palette, or typography mass",
        "fidelity_axes": ["layout silhouette", "light and mapped-field palette", "rounded shape language", "depth treatment", "typography mass"],
        "passing_axes": 4,
        "reject": ["Reference roles: none", "industrial machine in B1/B2", "dark chassis as B hero", "art-first B judged before headline compositing"]
      }
    },
    {
      "id": "brand:cluster-visual-accent",
      "kind": "brand_visual_rule",
      "label": "Cluster mapped color #635FD5",
      "props": {
        "product": "cluster.center",
        "games": ["cs2", "deadlock"],
        "hex": "#635FD5",
        "branch_a_role": "Small semantic accent on one element, normally 3-8% and never above 12%.",
        "branch_b_role": "Dominant field replacing the warm-story reference's yellow or amber background, normally 35-70% of the frame.",
        "rule": "Use the exact mapped hue with branch-dependent coverage; in B do not leave yellow dominant or reduce Cluster violet to one small prop."
      }
    },
    {
      "id": "brand:melonity-visual-accent",
      "kind": "brand_visual_rule",
      "label": "Melonity mapped color #FF1469",
      "props": {
        "product": "Melonity",
        "games": ["dota2"],
        "hex": "#FF1469",
        "branch_a_role": "Small semantic accent on one element, normally 3-8% and never above 12%.",
        "branch_b_role": "Dominant field replacing the warm-story reference's yellow or amber background, normally 35-70% of the frame.",
        "rule": "Use the exact mapped hue with branch-dependent coverage; in B do not leave yellow dominant or reduce Melonity pink to one small prop."
      }
    },
    {
      "id": "concept:branch-b-brand-field-replacement",
      "kind": "mandatory_visual_rule",
      "label": "Branch B replaces the yellow field with the mapped brand color",
      "props": {
        "rule": "Preserve the warm-story composition, rounded scene, lighting, depth, and typography mass, but replace the large yellow or amber background field with the mapped product color.",
        "cluster": "#635FD5",
        "melonity": "#FF1469",
        "target_area": "35-70% visible frame area; automated hue-family gate accepts approximately 25-75% after lighting and occlusion",
        "reject": ["yellow remains the dominant background", "mapped color appears only on a small tile or badge", "branch B is recolored into dark industrial branch A"]
      }
    },
    {
      "id": "concept:visual-prompt-grammar",
      "kind": "prompt_component_system",
      "label": "Sixteen-block master prompt grammar",
      "props": {
        "blocks": [
          "asset role",
          "editorial thesis",
          "visual metaphor",
          "format",
          "composition",
          "hero",
          "environment",
          "camera",
          "materials",
          "palette",
          "lighting",
          "typography",
          "reference roles",
          "physical plausibility",
          "constraints",
          "priority order"
        ]
      }
    },
    {
      "id": "concept:single-hero-hierarchy",
      "kind": "visual_rule",
      "label": "Single hero and three hierarchy levels",
      "props": {
        "hero_area": "35-65%; up to 80% for an intentional extreme crop",
        "hierarchy_levels_max": 3,
        "thumbnail_test": "The hero must remain recognizable at 240 px width."
      }
    },
    {
      "id": "concept:limited-palette",
      "kind": "visual_rule",
      "label": "Two or three color roles",
      "props": {
        "roles": ["field/background", "hero or typography", "secondary signal accent"],
        "canonical_families": ["acid yellow", "editorial lavender", "signal vermilion", "translucent blue", "warm device yellow", "industrial gray", "off-white", "charcoal"]
      }
    },
    {
      "id": "concept:tactile-materials",
      "kind": "visual_rule",
      "label": "Tactile industrial materials",
      "props": {
        "preferred": ["translucent cast plastic", "soft-touch plastic", "frosted acrylic", "stainless steel", "powder-coated metal", "shag textile", "dense paper"],
        "material_families_per_frame_max": 2
      }
    },
    {
      "id": "concept:controlled-surrealism",
      "kind": "visual_rule",
      "label": "Controlled physically believable surrealism",
      "props": {
        "rule": "Translate an abstract article thesis into one surprising but manufacturable physical object or scene.",
        "reject": "Random portals, magic smoke, floating clutter, implausible anatomy, or unrelated spectacle."
      }
    },
    {
      "id": "concept:typography-safe-zone",
      "kind": "visual_rule",
      "label": "Art-first and exact-text typography modes",
      "props": {
        "default": "art-first",
        "art_first": "Reserve a clean zone and prohibit all letters, pseudo-text, labels, and logos.",
        "text_in_image": "Provide exact quoted copy, language, case, line count, placement, type character, and prohibit all other text."
      }
    },
    {
      "id": "concept:reference-role-contract",
      "kind": "model_rule",
      "label": "One explicit role per image reference",
      "props": {
        "allowed_roles": ["composition", "material", "palette", "subject identity", "lighting", "camera"],
        "rule": "Never attach references without stating what to inherit and what must not be copied."
      }
    },
    {
      "id": "concept:visual-quality-gate",
      "kind": "quality_rule",
      "label": "100-point visual prompt quality gate",
      "props": {
        "passing_score": 80,
        "ready_score": 90,
        "categories": ["editorial clarity", "metaphor", "composition", "palette", "materials and light", "typography", "prompt specificity", "article fit", "authenticity and safety"],
        "automatic_rejection": "Missing thesis, hero, ratio, generated sequence index, B/A branch, mapped brand color role, reference roles, branch-B two-file reference fidelity, typography mode, incorrect branch-B yellow-field replacement, or inclusion of operational evasion content."
      }
    },
    {
